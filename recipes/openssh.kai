name=openssh
version=10.4p1
source=https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.4p1.tar.gz
sha256=ef6026dd2aea8d56059638d5d3262902c892ceba9f88395835e0d06d3fb63238
system_depends=gcc,make,perl
depends=openssl,zlib
build=./configure --prefix=/usr/local --sysconfdir=/etc/ssh --with-ssl-dir=/usr/local --with-zlib=/usr/local --without-pam && make -j$(nproc)
install=make DESTDIR="$DESTDIR" install-nokeys
