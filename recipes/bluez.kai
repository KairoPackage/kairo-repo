name=bluez
version=5.87
source=https://www.kernel.org/pub/linux/bluetooth/bluez-5.87.tar.xz
sha256=26bdcf2cebd7310c6f598850606b037ef0c515fe6608ebc54d22c50c4c32b35f
system_depends=gcc,make
depends=dbus,glib
build=./configure --prefix=/usr/local --sysconfdir=/etc --localstatedir=/var --enable-library --disable-systemd --disable-manpages --disable-docs --disable-testing && make -j$(nproc)
install=make DESTDIR="$DESTDIR" install
