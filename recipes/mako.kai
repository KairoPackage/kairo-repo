name=mako
version=1.11.0
source=https://github.com/emersion/mako/archive/refs/tags/v1.11.0.tar.gz
sha256=72d11d3fca20a3dfbca0107ff875eace479751be0cf2ddd1dd5bafa131ac7282
system_depends=gcc
depends=meson,ninja,pkgconf,wayland,wayland-protocols,dbus
build=meson setup build --prefix=/usr/local --buildtype=release -Dtests=false && meson compile -C build
install=meson install -C build --destdir "$DESTDIR"
