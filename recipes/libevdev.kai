name=libevdev
version=1.13.4
source=https://www.freedesktop.org/software/libevdev/libevdev-1.13.4.tar.xz
sha256=f00ab8d42ad8b905296fab67e13b871f1a424839331516642100f82ad88127cd
system_depends=gcc
depends=meson,ninja,pkgconf
