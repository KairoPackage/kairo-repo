name=fontconfig
version=2.18.2
source=https://gitlab.freedesktop.org/fontconfig/fontconfig/-/archive/2.18.2/fontconfig-2.18.2.tar.gz
sha256=a84d41b57cfb015783d7973b398c26d8763a64b803f97f31fa126fd2aa5eaaca
system_depends=gcc
depends=meson,ninja,pkgconf
build=meson setup build --prefix=/usr/local --buildtype=release -Ddoc=disabled -Dtests=disabled && meson compile -C build
install=meson install -C build --destdir "$DESTDIR"
