name=wayland
version=1.26.0
source=https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.26.0/downloads/wayland-1.26.0.tar.xz
sha256=64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3
system_depends=gcc
depends=meson,ninja,pkgconf
build=meson setup build --prefix=/usr/local --buildtype=release -Ddocumentation=false -Dtests=false && meson compile -C build
install=meson install -C build --destdir "$DESTDIR"
